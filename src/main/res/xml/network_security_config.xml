<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全配置（安全 M-3）
    ─────────────────────────────────────────────────────────────
    策略：
      · 生产流量（所有域名）只信任系统预装 CA，不信任用户手动安装的 CA。
        效果：拒绝 Charles / mitmproxy 等用户级证书做 MITM 抓包。
      · debug 构建（debugOverrides）恢复默认行为——保留用户 CA 信任，
        方便开发期抓包调试，不影响日常开发效率。
    注：本项目目前不做证书锁定（Pin），原因：
      · 后端为 Supabase + 第三方 LLM，证书更换不受控，Pin 会导致线上 crash。
      · 拒绝用户 CA 已覆盖绝大多数实际攻击面（需物理接触设备 + 手动安装 CA）。
-->
<network-security-config>

    <!-- 生产：只信任系统 CA，拒绝用户安装的 CA -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- debug 构建：额外信任用户 CA，允许抓包调试 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
